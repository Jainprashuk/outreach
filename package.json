{
  "name": "outreach-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend server for the Outreach email campaign tool (Gmail sending via nodemailer)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev:client": "cd client && npm run dev",
    "build:client": "cd client && npm install && npm run build",
    "scrape-worker": "node worker/scrape-worker.js",
    "naukri-worker": "node worker/naukri-worker.js",
    "workers": "bash worker/start-all.sh",
    "naukri-worker:stub": "NAUKRI_STUB=1 node worker/naukri-worker.js",
    "platform-worker": "node worker/platform-worker.js",
    "instahyre-worker": "PLATFORM=instahyre node worker/platform-worker.js",
    "hirist-worker": "PLATFORM=hirist node worker/platform-worker.js",
    "instahyre-worker:stub": "PLATFORM=instahyre PLATFORM_STUB=1 node worker/platform-worker.js",
    "hirist-worker:stub": "PLATFORM=hirist PLATFORM_STUB=1 node worker/platform-worker.js",
    "cutshort-worker": "PLATFORM=cutshort node worker/platform-worker.js",
    "wellfound-worker": "PLATFORM=wellfound node worker/platform-worker.js",
    "cutshort-worker:stub": "PLATFORM=cutshort PLATFORM_STUB=1 node worker/platform-worker.js",
    "wellfound-worker:stub": "PLATFORM=wellfound PLATFORM_STUB=1 node worker/platform-worker.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "imapflow": "^1.0.184",
    "inngest": "^4.5.1",
    "mailparser": "^3.9.9",
    "mongoose": "^9.7.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.11",
    "pdfkit": "^0.17.2",
    "playwright-core": "^1.63.0",
    "unpdf": "^1.9.0"
  }
}
