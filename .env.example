# MongoDB Atlas connection string (required for contacts/templates/settings)
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/outreach?retryWrites=true&w=majority
MONGODB_URI=

# Optional: pre-configure the Gmail sender at startup instead of using the
# Settings/Send screen. Copy this file to ".env" and fill in the values.
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
SENDER_NAME=Prashuk Jain
PORT=3000

# Inngest — sign up free at https://inngest.com to get these keys
# For local dev: run `npx inngest-cli@latest dev` alongside `npm start`
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
