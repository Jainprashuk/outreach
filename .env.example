# MongoDB Atlas connection string (required for contacts/templates/settings)
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/outreach?retryWrites=true&w=majority
MONGODB_URI=

# ── Credential encryption (required to store a Gmail password) ──────────────
# Gmail App Passwords are stored per user, encrypted with AES-256-GCM, because
# one database leak would otherwise expose every account's mailbox. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this makes every stored credential unreadable — they must be re-entered.
CREDENTIAL_KEY=

# Legacy single-owner Gmail credential. Now only a fallback for the account that
# predates per-user storage; move it into the database with:
#   node scripts/import-gmail-credential.js --email=you@example.com --execute
# and then remove these two.
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
SENDER_NAME=Prashuk Jain
PORT=3000

# Inngest — sign up free at https://inngest.com to get these keys
# For local dev: run `npx inngest-cli@latest dev` alongside `npm start`
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Optional: unique app id per deployment (defaults to "outreach-app").
# Set this to something else (e.g. "outreach-project") for a second instance.
INNGEST_APP_ID=

# ── Login ───────────────────────────────────────────────────────────────────
# Login is per-user: email + password, checked against the `users` collection.
# Create an account or reset a password with:
#   node scripts/set-password.js --email=you@example.com --create
#
# Signups are deliberately closed. Without verified email there is nothing
# stopping someone registering as anybody, so accounts are made out of band
# until OTP delivery exists.

# Set to 1 to leave the app completely open — local development ONLY. This
# replaces the old "no AUTH_PASSWORD set means no auth" rule, which failed open
# whenever the variable went missing.
AUTH_OPEN=

# ── Rollback path for the multi-tenant auth swap ────────────────────────────
# The old shared-password login. Set LEGACY_LOGIN=1 *and* AUTH_PASSWORD to
# re-enable it if per-user sessions ever lock you out of your own app. It
# authenticates "whoever knows the password", so it must go off again once a
# second account exists.
LEGACY_LOGIN=
AUTH_PASSWORD=
# HMAC secret for the legacy and share cookies (defaults to a built-in dev value)
AUTH_SECRET=

# Separate password for the public read-only "Export Contacts" share page.
# Share the URL /app/export-contacts + this password with outsiders; they can
# only use the export tab (all other pages show "Not authorised"). Leave unset
# to disable sharing.
EXPORT_PASSWORD=

# Reply classifier — auto-categorises inbound replies (reviewing / stay-in-touch / no /
# resume-requested / needs-attention / other) during the mailbox check.
#
# A deterministic rule pass runs first and settles the obvious cases (out-of-office
# autoreplies, unsubscribes, flat rejections) without any API call at all. Anything left
# goes to the first working provider in the chain below, so one exhausted free tier no
# longer means no classification.
#
# Each key is independent: set none, one, or all. With no keys the rules still run and
# everything else is left unclassified (replies are still detected and stored).
# Groq is the default primary: Gemini's free tier is only 20 requests PER DAY on
# gemini-3-flash, which one mailbox sweep can exhaust on its own.
GROQ_API_KEY=          # free at https://console.groq.com/keys
GEMINI_API_KEY=        # free at https://aistudio.google.com/apikey
CEREBRAS_API_KEY=      # free at https://cloud.cerebras.ai

# Optional. CLASSIFIER_PROVIDER_ORDER also doubles as a per-provider kill switch — drop a
# name from the list to stop using it without unsetting its key.
# GROQ_MODEL=openai/gpt-oss-20b
# GEMINI_MODEL=gemini-3-flash-preview
# CEREBRAS_MODEL=gpt-oss-120b
# CLASSIFIER_PROVIDER_ORDER=groq,gemini,cerebras

# Shared secret for the scheduled GitHub Actions jobs (posting sync, mailbox check).
# Sent as the X-Cron-Secret header. Set the SAME value in Vercel env vars and in
# GitHub > Settings > Secrets and variables > Actions.
# Leave blank locally: with AUTH_PASSWORD unset the whole app is open anyway.
CRON_SECRET=

# ── Excel drip campaigns ─────────────────────────────────────────────────────
# Campaigns release contacts on a schedule with nobody at the keyboard, so they
# can only use credentials that exist on a cold start — i.e. GMAIL_EMAIL and
# GMAIL_APP_PASSWORD above. (/api/config writes to per-instance memory that a
# cron invocation never sees.) Creating a campaign is refused if they are unset.
#
# The daily release is driven by .github/workflows/run-campaigns.yml, which
# posts to /api/campaigns/run-due hourly using CRON_SECRET; each campaign picks
# its own release hour in IST.
#
# Soft ceiling used ONLY to warn in the UI when the combined daily total across
# running campaigns gets close to Gmail's ~500/day. Nothing is ever throttled.
DAILY_SEND_CAP=400

# ── LinkedIn scrape worker ──────────────────────────────────────────────────
# Shared secret between the portal and worker/scrape-worker.js, which runs on
# the Mac (the harvest drives a real logged-in Chrome over CDP and cannot run
# on Vercel). Set the SAME value here and in the Vercel env. Unset = the worker
# endpoints are unreachable and the Scrape panel stays idle.
#
# Scraping is opt-in PER ACCOUNT: the harvest drives a real, logged-in Chrome on
# a real machine, which is exactly what keeps the LinkedIn account unrestricted,
# and that does not generalise to a shared pool. Each account registers its own
# machine and gets its own token:
#   POST /api/scrapes/worker-token   (returns the value once)
# and that token goes in the WORKER machine's .env as WORKER_SECRET.
#
# The value below is the LEGACY single-owner secret. It still works, but only
# while exactly one account exists — otherwise one shared secret could claim
# anybody's runs. Leave it unset once every worker has its own token.
WORKER_SECRET=

# Worker-side only (not needed by the server):
#   OUTREACH_URL   where the portal lives, e.g. https://your-app.vercel.app
#   JL_REPO        path to the scraper repo (default ~/Desktop/linkdin-post)
#   POLL_MS        claim poll interval (default 20000)
